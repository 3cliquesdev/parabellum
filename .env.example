NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Segredo aleatorio independente, com pelo menos 32 caracteres.
# Nunca reutilize SUPABASE_SERVICE_ROLE_KEY.
INTERNAL_API_SECRET=
# Chave exclusiva do importador historico Kiwify do CRM Lovable. Use 32+ caracteres.
LOVABLE_KIWIFY_IMPORT_SECRET=
# Endpoint e chave de leitura do CRM antigo. Nunca exponha no frontend ou n8n.
LEGACY_TICKETS_MIGRATION_URL=
LEGACY_TICKETS_MIGRATION_KEY=
LEGACY_TICKETS_TENANT_ID=
CRON_SECRET=

GOOGLE_CLOUD_PROJECT=
GOOGLE_SERVICE_ACCOUNT_JSON=
VERTEX_AI_LOCATION=us-central1

META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Webhook temporario de migracao: a Meta entrega aqui e o 3Cliques encaminha
# o numero antigo ao CRM legado, usando o phone_number_id de cada evento.
WHATSAPP_ROUTER_VERIFY_TOKEN=
WHATSAPP_MAIN_PHONE_NUMBER_ID=
WHATSAPP_MAIN_FORWARD_URL=
CUSTOMER_DATA_WEBHOOK_SECRET=
CUSTOMER_DATA_QUERY_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INBOX_INGEST_SECRET=
OPUS_LEAD_TENANT_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gerar em n8n > Settings > n8n API. Sem isso, a tela Studio IA > Agentes
# continua funcionando (salva no CRM), so nao sincroniza com o workflow.
N8N_API_URL=
N8N_API_KEY=
